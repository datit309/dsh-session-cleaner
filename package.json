{
  "name": "dsh-session-cleaner",
  "version": "1.0.0",
  "description": "Auto-detect, unstick, and safely delete corrupted or error-stuck sessions in DeepSeek Harness (DSH)",
  "type": "module",
  "main": "index.js",
  "bin": {
    "dsh-session-cleaner": "./bin/cli.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "scan": "node ./bin/cli.js scan",
    "clean": "node ./bin/cli.js clean"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "session-cleaner",
    "session-repair",
    "session-doctor"
  ],
  "author": "datit309",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datit309/dsh-session-cleaner.git"
  },
  "bugs": {
    "url": "https://github.com/datit309/dsh-session-cleaner/issues"
  },
  "homepage": "https://github.com/datit309/dsh-session-cleaner#readme"
}
